rm -f ~/clickshop/server.js && cat << 'EOF' > ~/clickshop/server.js
const express = require('express');
const path = require('path');
const multer = require('multer');
const mongoose = require('mongoose');
const cloudinary = require('cloudinary').v2;
const { CloudinaryStorage } = require('multer-storage-cloudinary');

const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json({ limit: '50mb' }));
app.use(express.urlencoded({ limit: '50mb', extended: true }));

cloudinary.config({
  cloud_name: process.env.CLOUDINARY_CLOUD_NAME,
  api_key: process.env.CLOUDINARY_API_KEY,
  api_secret: process.env.CLOUDINARY_API_SECRET
});

const storage = new CloudinaryStorage({
  cloudinary: cloudinary,
  params: {
    folder: 'clickshop/uploads',
    allowed_formats: ['jpg', 'jpeg', 'png', 'webp', 'gif']
  }
});

const upload = multer({
  storage: storage,
  limits: { fileSize: 15 * 1024 * 1024 }
});

const MONGODB_URI = process.env.MONGODB_URI;

const defaultSiteSettings = {
  logoUrl: 'https://i.ibb.co/6P82W8h/default-avatar.png',
  whatsapp: '213700000000',
  telegramBotToken: '',
  announcementType: 'text',
  announcementText: ''
};

const PlatformSchema = new mongoose.Schema(
  {
    key: { type: String, required: true, unique: true, default: 'main_state' },
    stores: { type: Array, default: [] },
    siteSettings: { type: Object, default: () => ({ ...defaultSiteSettings }) },
    orders: { type: Array, default: [] }
  },
  { minimize: false, timestamps: true }
);

const PlatformModel = mongoose.model('PlatformState', PlatformSchema);

async function getOrCreateState() {
  let doc = await PlatformModel.findOne({ key: 'main_state' });
  if (!doc) {
    doc = await PlatformModel.create({
      key: 'main_state',
      stores: [],
      siteSettings: { ...defaultSiteSettings },
      orders: []
    });
  }
  return doc;
}

app.use(express.static(path.join(__dirname, 'public')));
app.use('/views', express.static(path.join(__dirname, 'views')));

app.get('/', (req, res) => {
  res.sendFile(path.join(__dirname, 'index.html'));
});

app.get('/api/health', (req, res) => {
  const dbConnected = mongoose.connection.readyState === 1;
  res.json({
    ok: true,
    dbConnected,
    storage: 'MongoDB Atlas + Cloudinary'
  });
});

app.get('/api/state', async (req, res) => {
  try {
    const state = await getOrCreateState();
    res.json({
      stores: state.stores || [],
      siteSettings: { ...defaultSiteSettings, ...(state.siteSettings || {}) },
      orders: state.orders || []
    });
  } catch (err) {
    console.error('Error fetching state:', err);
    res.status(500).json({ error: 'فشل تحميل البيانات من قاعدة البيانات' });
  }
});

app.post('/api/state', async (req, res) => {
  try {
    const { stores, siteSettings, orders } = req.body || {};
    const current = await getOrCreateState();

    const updated = await PlatformModel.findOneAndUpdate(
      { key: 'main_state' },
      {
        $set: {
          stores: Array.isArray(stores) ? stores : current.stores,
          siteSettings:
            siteSettings && typeof siteSettings === 'object'
              ? { ...defaultSiteSettings, ...current.siteSettings, ...siteSettings }
              : current.siteSettings,
          orders: Array.isArray(orders) ? orders : current.orders
        }
      },
      { new: true, upsert: true }
    );

    res.json({
      ok: true,
      stores: updated.stores,
      siteSettings: updated.siteSettings,
      orders: updated.orders
    });
  } catch (err) {
    console.error('Error saving state:', err);
    res.status(500).json({ error: 'فشل حفظ البيانات في قاعدة البيانات' });
  }
});

app.post('/api/upload', upload.single('image'), (req, res) => {
  try {
    if (!req.file) {
      return res.status(400).json({ error: 'لم يتم إرسال أي صورة' });
    }
    res.json({
      ok: true,
      url: req.file.path,
      publicId: req.file.filename
    });
  } catch (err) {
    console.error('Upload error:', err);
    res.status(500).json({ error: 'فشل رفع الصورة إلى Cloudinary' });
  }
});

app.post('/api/upload-multiple', upload.array('images', 10), (req, res) => {
  try {
    if (!req.files || req.files.length === 0) {
      return res.status(400).json({ error: 'لم يتم إرسال أي صور' });
    }
    const urls = req.files.map((file) => file.path);
    res.json({
      ok: true,
      urls
    });
  } catch (err) {
    console.error('Multi-upload error:', err);
    res.status(500).json({ error: 'فشل رفع الصور إلى Cloudinary' });
  }
});

app.use((err, req, res, next) => {
  if (err) {
    console.error('Server/Upload error:', err.message);
    return res.status(400).json({ error: err.message || 'خطأ أثناء معالجة الطلب' });
  }
  next();
});

async function startServer() {
  if (!MONGODB_URI) {
    console.warn('⚠️ تحذير: المتغير MONGODB_URI غير مضبوط بعد.');
  } else {
    try {
      await mongoose.connect(MONGODB_URI);
      console.log('✅ تم الاتصال بـ MongoDB Atlas بنجاح');
      await getOrCreateState();
    } catch (err) {
      console.error('❌ خطأ في الاتصال بـ MongoDB Atlas:', err.message);
    }
  }

  app.listen(PORT, () => {
    console.log(`🚀 ClickShop server running on port ${PORT}`);
  });
}

startServer();
EOF
node -c ~/clickshop/server.js && head -n 5 ~/clickshop/server.js
